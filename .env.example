DJANGO_SECRET_KEY=replace-with-a-local-secret
DEBUG=true
CLASS_ACCESS_CODE=replace-with-the-shared-class-code
REQUIRE_CLASS_LOGIN=false
SESSION_COOKIE_AGE=604800

# Optional: keep private data outside the project directory.
# Both values must be absolute paths. Create the parent directories first.
# DJANGO_DATABASE_PATH=/absolute/path/to/private/class-profile/db.sqlite3
# DJANGO_MEDIA_ROOT=/absolute/path/to/private/class-profile/media
